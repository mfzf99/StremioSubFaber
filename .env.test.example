# SubFaber - Test Keys Template (LIVE API KEYS FOR INTERNAL DEVELOPMENT)
# =====================================================================
# AMARAN: JANGAN isi kunci sebenar dalam fail ini.
# Fail ini adalah TEMPLAT yang dijejak Git (kosong selamanya).
#
# Langkah persediaan (Owner sahaja, di luar kawalan Git):
#   1. copy .env.test.example .env.test.local
#   2. Isi kunci sebenar dalam .env.test.local menggunakan editor teks.
#   3. .env.test.local DITOLAK secara automatik oleh .gitignore (corak .env.*.local)
#      - sahkan dengan: git status --porcelain (fail itu TIDAK muncul).
#
# SKOP PENGGUNAAN KUNCI UJIAN (mandat Owner):
#   - Pengesahan sambungan sahaja (connectivity ping / model list validation).
#   - Ujian automasi UI oleh Frontend via Playwright (pengisian borang Custom Provider).
#   - DILARANG untuk larian terjemahan pukal (zero bulk translation runs / zero token waste).
#
# PROTOKOL "ZERO SECRET LOGGING":
#   - Nilai kunci HARAM dicetak ke terminal, stdout/stderr, fail log, atau tangkapan skrin.
#   - Nilai kunci HARAM dicatatkan dalam docs/SESSION_LEDGER.md atau mana-mana artifak Git.
# =====================================================================

# Gemini rasmi (Google AI Studio) - senarai berbilang kunci dipisahkan koma.
# Format lama 'AIza...' dan baru 'AQ....' kedua-duanya diterima; dibaca
# melalui getTestKeyList('GEMINI_KEYS') dalam src/utils/testKeys.js.
SUBFABER_TEST_GEMINI_KEYS=

# Gemini - kunci tunggal untuk ujian pantas (satu nilai sahaja)
SUBFABER_TEST_GEMINI_KEY=

# Rootsys (OpenAI-compatible gateway) - kunci + base URL pintu /v1
SUBFABER_TEST_ROOTSYS_KEY=
SUBFABER_TEST_ROOTSYS_BASE_URL=

# Rootsys - pintu Anthropic-compatible (base URL tanpa /v1)
SUBFABER_TEST_ROOTSYS_ANTHROPIC_BASE_URL=

# Crazy Router (Gemini-native proxy gateway) - kunci 'sk-...' + base URL pintu /v1beta
SUBFABER_TEST_CRAZYROUTER_KEY=
SUBFABER_TEST_CRAZYROUTER_BASE_URL=

# Crazy Router - pintu OpenAI-compatible (base URL /v1)
SUBFABER_TEST_CRAZYROUTER_OPENAI_BASE_URL=
